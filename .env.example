# Plantilla. El archivo real va en %LOCALAPPDATA%\TRADING\.env (Windows) o ~/.trading/.env: NUNCA en el repo.
# Telegram (alertas): el bot se crea con @BotFather; el chat lo da `python -m tradingagent telegram-chats`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# SEC (EDGAR y comunicados): la SEC exige nombre y mail de contacto en el User-Agent, p. ej. "Nombre mail@dominio".
SEC_USER_AGENT=
# Receptor de webhooks (opcional): secreto de al menos 16 caracteres para firmar los pedidos.
WEBHOOK_SECRET=
# Opcional: servidor propio de la Bot API de Telegram.
# TELEGRAM_API_BASE=
