# Agente de TRADING en el servidor de Tokio (fase 2 de docs/RELE-TOKIO.md: SIMULACRO, plata de mentira).
# Instalar o actualizar: deploy/tokio/instalar-agente.sh (lo copia a /etc/systemd/system y lo arranca).
[Unit]
Description=TRADING - agente de Tokio (simulacro): avisos del relé, Binance a 2-5 ms, telemetría a la PC
After=network-online.target rele-tokio.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/trading
Environment=TRADING_HOME=/home/ubuntu/.trading
Environment=PYTHONUNBUFFERED=1
# Sin EnvironmentFile: el agente lee SOLO TRADING_HOME/.env, armado con deploy/tokio/preparar_env.py (la IA, la clave
# de SOLO LECTURA de Binance y el SEC_USER_AGENT; nunca la clave de trading). El .env del dueño no se carga.
ExecStart=/home/ubuntu/trading/.venv/bin/python -m tradingagent run
Restart=always
RestartSec=10
# Poca memoria (416 MB, sin swap): si falta, el kernel mata antes a otros procesos que a los de TRADING (el 5-nov
# mató al agente mientras pip instalaba).
OOMScoreAdjust=-500
# Y nunca más que esto (el servidor tiene ~900 MB desde el 6-nov): pasando MemoryHigh se le recupera memoria; pasando
# MemoryMax, el kernel mata solo al agente y systemd lo relanza a los 10 s. Usa ~130 MB. El 5-nov la falta de memoria
# del sistema hizo que systemd-networkd diera la red por caída (docs/TRASPASO.md §11).
MemoryHigh=400M
MemoryMax=500M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
